<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>REIMA</AssemblyName>
    <RootNamespace>Reima</RootNamespace>
    <Product>Realistic and Immersive Modpack for Anomaly</Product>
    <Version>0.1.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- loose files next to REIMA.exe (single-file publish must not swallow them: the launcher runs aria2c from disk) -->
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="tools\**" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- rclone is a maintainer tool (uploads to the Drive), not shipped to players -->
    <None Update="tools\rclone.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
